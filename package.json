{
  "name": "echo-dynamic-island",
  "version": "1.0.4",
  "description": "KUKU AI Desktop Assistant",
  "main": "main.js",
  "author": "Lawal",
  "scripts": {
    "start": "node inject-key.js && electron .",
    "build": "node inject-key.js && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "pdf-parse": "^1.1.1",
    "screenshot-desktop": "^1.15.8"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kuku.island",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "KUKU-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KUKU"
    },
    "publish": {
      "provider": "github",
      "owner": "echoinfoteam-oss",
      "repo": "kuku-app"
    },
    "files": [
      "main.js",
      "index.html",
      "onboarding.html",
      "filedrop-video.html",
      "*.mp4",
      "icon.ico"
    ]
  }
}
